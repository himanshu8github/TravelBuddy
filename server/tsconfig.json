{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
"moduleResolution": "node16",

    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "skipLibCheck": true,

    "incremental": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}